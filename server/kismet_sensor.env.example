# Server-owned Kismet sensor configuration.
# Copy these settings into server/.env, or use this file as the deployment
# profile for a future Linux sensor. No application code should contain
# machine-specific Kismet paths or interface names.

# Current development Linux host:
KISMET_CAPTURE_ROOT=/home/adonis/kismet
KISMET_CAPTURE_INTERFACE=wlp0s20f3mon
KISMET_MAIN_INTERFACE=wlp0s20f3
# Runtime state belongs to the dedicated service account.
KISMET_HOMEDIR=/var/lib/kismet
KISMET_BINARY=/usr/local/bin/kismet
KISMET_CONF_DIR=/home/adonis/kismet/conf

# Operational policy. Keep cleanup in dry-run until the production policy is approved.
KISMET_RETENTION_HOURS=48
KISMET_MIN_FREE_BYTES=5368709120
KISMET_HEALTH_STALE_SECONDS=300
KISMET_CLEANUP_DRY_RUN=true

# Kismet management/API policy. Bind locally unless an approved private address
# and authentication policy has been verified.
KISMET_API_BIND_ADDRESS=127.0.0.1
KISMET_API_AUTH_ENABLED=true
API_HOST=127.0.0.1

# Explicit deployment gate; set true only after Phase 10 approval.
KISMET_PRODUCTION_READY=false
