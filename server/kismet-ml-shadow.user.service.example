[Unit]
Description=Network Scanner Kismet ML Shadow Processing (User)

[Service]
Type=oneshot
WorkingDirectory=/home/adonis/network-scanner
EnvironmentFile=-/home/adonis/network-scanner/server/kismet_sensor.env
Environment=KISMET_ML_MAX_OBSERVATIONS_PER_RUN=1000
ExecStart=/usr/bin/python3 /home/adonis/network-scanner/server/run_kismet_ml_shadow.py

# User services already run as adonis. This process only opens Kismet captures
# with SQLite mode=ro and writes derived data under KISMET_ML_STORAGE_DIR.
